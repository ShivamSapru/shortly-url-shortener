{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1 tests/unit/shortCode.test.js tests/unit/url.service.test.js tests/unit/stats.service.test.js tests/integration/api.test.js",
    "test:api": "postman collection run \"postman/collections/URL Shortener API\" --delay-request 200"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "postman-cli": "^1.62.0",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
